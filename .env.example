# Copy to .env and adjust. Never commit real secrets.

# Shared bearer for /v1/* (UI, hooks, fleet)
GUARD_API_SECRET=jzg_demo_secret

# Live Jev via OpenRouter Decisions API (optional — falls back to stub if missing/unreachable)
OPENROUTER_API_KEY=
# JEV_MODEL=jev-1.13
# JEV_STUB=1

# Cursor Agent CLI for fleet builds (optional — falls back to noop executor)
# CURSOR_API_KEY=
# CURSOR_AGENT_BIN=
# FLEET_EXECUTOR=cursor
# FLEET_EXECUTOR_REQUIRE=1

# Hook / CLI identity defaults
# JEV_GUARD_URL=http://127.0.0.1:8787
# JEV_TENANT_ID=dev
# JEV_AGENT_ID=cursor-junior
# JEV_GUARD_BYPASS=1
